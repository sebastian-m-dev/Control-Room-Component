# ============================================================
# Variables de entorno · Control Room
# Copia este archivo como `.env.local` y rellena SOLO lo que vayas
# a usar. Ninguno de estos valores debe subirse al repositorio.
# ============================================================

# ---------------------------------------------------------------------------
# Traccar API (solo backend, nunca se exponen al cliente)
# ---------------------------------------------------------------------------
# Software open source (Apache 2.0). Puedes registrarte gratis en
# https://demo4.traccar.org o usar tu propio servidor Traccar.
# Si dejas estas variables VACÍAS, la app arranca en Modo Demo con datos
# simulados y el formulario de login permite conectar credenciales manuales.
TRACCAR_BASE_URL=
TRACCAR_EMAIL=
TRACCAR_PASSWORD=

# Email sugerido en el formulario de login (público, no es un secreto).
# Con `NEXT_PUBLIC_` llega al navegador: NO pongas aquí contraseñas.
NEXT_PUBLIC_TRACCAR_EMAIL=

# ---------------------------------------------------------------------------
# Google Maps Platform (necesaria para el mapa y las rutas del Modo Demo)
# ---------------------------------------------------------------------------
# 1) Crea una API key en Google Cloud Console → APIs & Services.
# 2) Habilita: Maps JavaScript API + Directions API.
# 3) Restringe la key por "HTTP referrers" (p. ej. http://localhost:3000).
# La variable con `NEXT_PUBLIC_` es visible en el cliente (es una API key
# de mapa, no un secreto); aún así, restríngela siempre por referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Key server-side SOLO para la Directions API (rutas del Modo Demo).
# Los web services de Google (Directions) no admiten keys restringidas por
# referrer: la llamada se hace desde el servidor, sin cabecera Referer, y
# Google la rechaza con REQUEST_DENIED. Crea una key distinta a la del mapa,
# habilita únicamente la "Directions API" y NO le pongas restricción por
# referrer (puedes limitarla por IP o dejarla solo restringida por API).
# Si la dejas vacía, se usa la key pública del mapa como fallback local.
GOOGLE_DIRECTIONS_API_KEY=
